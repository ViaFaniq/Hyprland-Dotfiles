{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": [
        "custom/prompt",
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/media",
        "cpu",
        "memory",
        "temperature",
        "disk",
        "network",
        "pulseaudio",
        "idle_inhibitor",
        "tray"
    ],

    "custom/prompt": {
        "exec": "printf '$ %s@%s ~' \"$USER\" \"$(cat /etc/hostname)\"",
        "interval": 60,
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "[{name}]",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "sort-by-number": true,
        "all-outputs": true,
        "persistent-workspaces": {
            "*": 5
        },
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true,
        "tooltip": false
    },

    "clock": {
        "format": "[ {:%H:%M:%S} ]",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/media": {
        "exec": "playerctl metadata --format='{{status}} | {{artist}} - {{title}}' 2>/dev/null",
        "exec-if": "playerctl status >/dev/null 2>&1",
        "interval": 2,
        "format": "MEDIA:{}",
        "max-length": 40,
        "escape": true,
        "on-click": "playerctl play-pause 2>/dev/null",
        "on-click-right": "playerctl next 2>/dev/null",
        "on-click-middle": "playerctl previous 2>/dev/null"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU:{usage:02d}%",
        "tooltip": true
    },

    "memory": {
        "interval": 3,
        "format": "RAM:{percentage:02d}%",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    "temperature": {
        "interval": 3,
        "critical-threshold": 80,
        "format": "TEMP:{temperatureC}°C",
        "format-critical": "TEMP:{temperatureC}°C!",
        "tooltip": true
    },

    "disk": {
        "interval": 30,
        "format": "DSK:{percentage_used}%",
        "path": "/",
        "tooltip": true,
        "tooltip-format": "Root: {used} / {total} ({percentage_used}%)",
        "on-click": "kitty -e df -h /"
    },

    "network": {
            "interval": 2,
            "format-wifi": "NET:{ipaddr}",
            "format-ethernet": "NET:{ipaddr}",
            "format-disconnected": "NET:OFF",
            "format-alt": "NET:↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
            "tooltip-format": "Interfejs: {ifname}\nIP: {ipaddr}/{cidr}\n↓ Pobieranie: {bandwidthDownBytes}\n↑ Wysyłanie: {bandwidthUpBytes}",
            "on-click-right": "kitty -e nmtui"
        },

    "pulseaudio": {
        "format": "VOL:{volume}%",
        "format-muted": "VOL:MUTE",
        "tooltip": true,
        "tooltip-format": "Głośność: {volume}%",
        "on-click": "pavucontrol"
    },

    "idle_inhibitor": {
        "format": "IDLE:{icon}",
        "format-icons": {
            "activated": "OFF",
            "deactivated": "ON"
        },
        "tooltip": true
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    }
}