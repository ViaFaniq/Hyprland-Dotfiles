[global]
    monitor = 0
    follow = mouse
    
    # Nowa składnia offset i height (Dunst >= 1.12)
    origin = top-right
    offset = (12, 12)
    width = (280, 380)
    height = (0, 110)
    
    # Wygląd
    font = JetBrainsMono Nerd Font 10
    corner_radius = 0
    frame_width = 1
    padding = 12
    horizontal_padding = 14
    icon_position = off
    
    # Stylistyka tekstowa
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    frame_color = "#313244"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
